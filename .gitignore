# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vigil
build.log

# Internal security/ops evaluations (local-only until Critical RLS remediated)
# See docs/README.md one-liner — do not commit raw audit findings.
/docs/evaluations/

# PWA service worker (generated at build)
public/sw.js
public/sw.js.map
public/workbox-*.js
public/swe-worker-*.js
public/fallback-*.js

.vercel
.env*

# Internal security/ops evaluations + private doc archives (local-only).
# See docs/architecture/CLAUDE.md Process rules — do not commit raw audit
# findings, counsel memos, or full build-prompt archives.
/docs/evaluations/

# Guard against generator/design exports landing at repo root (75 §6).
# Shipping icons live in public/; prompts live in docs/build-process/ (or
# private archive under docs/evaluations/ when sensitive).
/vigil-*.png
/vigil-*.ico
/*.tmp.pdf
/vigil-press-kit.zip
# Numbered prompt drafts must not linger at repo root.
/[0-9][0-9]-*.md
/[0-9][0-9][A-Z]-*.md
