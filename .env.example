# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git

# Supabase — get from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin access — comma-separated emails allowed to access /admin
VIGIL_ADMIN_EMAILS=

# Security — random secret for IP hashing and internal checks
VIGIL_ADMIN_SECRET=

# Optional — durable API rate limits (Upstash Redis REST).
# When unset, middleware falls back to in-memory Map (fine for local; multi-isolate
# production should set these so claim/admin/AI limits survive cold starts).
# Create a free Redis DB at https://upstash.com → REST URL + token.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional integrations
# RESEND_API_KEY — outbound alerts; verify sending domain youthewave.org in Resend (not youtheway.org)
ANTHROPIC_API_KEY=
# Optional: route Anthropic via Vercel AI Gateway for spend visibility
# ANTHROPIC_BASE_URL=
# AI circuit breaker — request-count proxy units (sonnet=10, haiku=1). Tunable live without redeploy.
# AI_DEGRADE_THRESHOLD=800
# AI_HALT_THRESHOLD=2000
CRON_SECRET=
RESEND_API_KEY=
# Optional From override (must be on a domain verified in Resend). Defaults to
# CRISIS_CONFIG.legal.contactEmail (vigil@youthewave.org).
# RESEND_FROM_EMAIL=vigil@youthewave.org
# Optional Make.com intake bridge → POST /api/make/webhook (Bearer).
# WhatsApp / Telegram scenarios POST here with source=whatsapp|telegram|partner.
# When unset the route returns 503 (no open intake). Same sanitize/Zod as web submit.
MAKE_WEBHOOK_SECRET=

# Desaparecidos Terremoto Venezuela — federated search (read-only, no data stored)
DTV_API_BASE_URL=
DTV_API_KEY=

# ReliefWeb (OCHA) v2 — official humanitarian updates on /informacion.
# v2 requires a PRE-APPROVED appname (enforced since 1 Nov 2025). Until this is
# set to an approved value the client skips the network call and the Official-
# Updates section is suppressed. Request one: https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME=
